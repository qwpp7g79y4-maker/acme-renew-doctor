{
  "schema_version": 1,
  "tool": {
    "name": "acme-renew-doctor",
    "version": "0.2.0"
  },
  "input": {
    "domain": "example.com",
    "all": false,
    "client": "auto",
    "from_log": null,
    "from_timer_status": null,
    "from_cert_disk": "tests/fixtures/certs/not-a-cert.txt",
    "from_cert_live": "tests/fixtures/certs/dates-current.txt"
  },
  "findings": [
    {
      "code": "INSUFFICIENT_EVIDENCE",
      "layer": null,
      "confidence": "high",
      "evidence": [
        {
          "source": "disk",
          "text": "certificate dates not recognised (no notAfter= line in openssl x509 -dates output)"
        }
      ]
    },
    {
      "code": "INSUFFICIENT_EVIDENCE",
      "layer": null,
      "confidence": "low",
      "evidence": [
        {
          "source": "timer",
          "text": "no timer status"
        },
        {
          "source": "log",
          "text": "no log given"
        },
        {
          "source": "disk",
          "text": "no disk notAfter"
        }
      ]
    }
  ],
  "next_checks": [
    {
      "for": "INSUFFICIENT_EVIDENCE",
      "command": "systemctl show certbot.timer certbot.service -p Id,LoadState,ActiveState,SubState,UnitFileState,Result,ConditionResult,LastTriggerUSec,NextElapseUSecRealtime",
      "why": "save this output yourself and pass the file with --from-timer-status",
      "safety": "read-only"
    },
    {
      "for": "INSUFFICIENT_EVIDENCE",
      "command": "sudo tail -n 400 /var/log/letsencrypt/letsencrypt.log",
      "why": "save a copy yourself and pass it with --from-log",
      "safety": "read-only"
    },
    {
      "for": "INSUFFICIENT_EVIDENCE",
      "command": "sudo openssl x509 -noout -dates -in /etc/letsencrypt/live/example.com/fullchain.pem",
      "why": "save this output yourself and pass the file with --from-cert-disk",
      "safety": "read-only"
    },
    {
      "for": "INSUFFICIENT_EVIDENCE",
      "command": "echo | timeout 10 openssl s_client -connect example.com:443 -servername example.com | openssl x509 -noout -dates",
      "why": "save this output yourself and pass the file with --from-cert-live",
      "safety": "read-only"
    }
  ],
  "exit_code": 2
}
